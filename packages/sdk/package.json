{
  "name": "@cloudsforge/sdk",
  "version": "0.3.0",
  "description": "Typed client for the CloudsForge public API: wallets, portfolio, activity, pricing, mint, market, foresight and worlds.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cloudsforge",
    "api",
    "sdk",
    "wallet",
    "marketplace"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  }
}
